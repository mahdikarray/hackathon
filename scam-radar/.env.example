# Scam Radar - Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must NEVER be committed.

# Groq API key - powers the independent AI assessment in the scanner.
# Get one free at: https://console.groq.com/keys
# Format: gsk_...
GROQ_API_KEY=gsk_your_key_here

# Public app URL, used for share links on the result page.
# In production set this to your deployed origin, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The rules-based detector in src/lib/rules.ts and src/lib/detector.ts needs no
# configuration and runs entirely offline. If GROQ_API_KEY is missing or the
# API times out, the app still works and the AI panel reports "unavailable".
