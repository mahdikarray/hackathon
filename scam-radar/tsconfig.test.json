{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/lib/rules.ts",
    "src/lib/detector.ts",
    "src/lib/agreement.ts",
    "src/lib/ai-parse.ts",
    "src/lib/i18n-dictionary.ts",
    "src/lib/game-messages.ts",
    "tests/**/*.ts"
  ]
}
